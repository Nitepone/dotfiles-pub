#!/bin/bash
# Simple script to quickly find my config files..


# -- START Tab Completion Subscript --
declare -A CFGEDIT_CFG_FILES=( \
	#XXX No spaces in file paths!!!
	["nvim"]="${HOME}/.config/nvim/init.lua" \
	["bspwm"]="${HOME}/.config/bspwm/bspwmrc" \
	["sxhkd"]="${HOME}/.config/sxhkd/sxhkdrc" \
	["polybar"]="${HOME}/.config/polybar/config" \
	["fuzzel"]="${HOME}/.config/fuzzel/fuzzel.ini /etc/xdg/fuzzel/fuzzel.ini" \
	["niri"]="${HOME}/.config/niri/config.kdl ${HOME}/waybar/config /etc/xdg/waybar/config" \
	["waybar-cfg"]="${HOME}/.config/waybar/config ${HOME}/waybar/config /etc/xdg/waybar/config" \
	["waybar-css"]="${HOME}/.config/waybar/style.css ${HOME}/waybar/style.css /etc/xdg/waybar/style.css" \
	["eww-cfg"]="${HOME}/.config/eww/config /etc/xdg/eww/config" \
	["eww-css"]="${HOME}/.config/eww/style.css /etc/xdg/eww/style.css" \
)

function _cfgedit_completions {
	case "${#COMP_WORDS[@]}" in
		"2")
			# shellcheck disable=SC2207
			# this works, 1v1 me in mw2, interventions on rust
			COMPREPLY+=( $(compgen -W "${!CFGEDIT_CFG_FILES[*]}" "${COMP_WORDS[1]}" ) )
			;;
	esac
}

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
	complete -F _cfgedit_completions cfgedit
	# if being sourced, return before entering main program
	return
fi
# -- END Tab Completion --


declare -r EDITOR="nvim"

function pr {
	printf "%s\n" "$*"
}

function pr_error {
	if test -t 0; then
		printf "\e[31m%s\e[0m\n" "$*" >&2
	else
		echo "ERROR: $*" >&2
	fi
}

function pr_info {
	if test -t 0; then
		printf "\e[2m%s\e[0m\n" "$*"
	else
		echo "$*"
	fi
}

function get_existing_cfg_path {
	local app_name="$1"
	local IFS=' '
	# shellcheck disable=SC2206
	local app_cfg_paths=( ${CFGEDIT_CFG_FILES[$app_name]} )
	for possible_path in "${app_cfg_paths[@]}" ; do
		if test -f "${possible_path}"; then
			echo "$possible_path"
			return 0
		fi
	done
	return 1
}

function get_first_cfg_path {
	local app_name="$1"
	local IFS=' '
	# shellcheck disable=SC2206
	local app_cfg_paths=( ${CFGEDIT_CFG_FILES[$app_name]} )
	local app_first_path=${app_cfg_paths[0]}
	if test -n "${app_first_path}"; then
		echo "${app_first_path}"
		return 0
	fi
	return 1
}

function pr_usage {
	local missed_app_names=()
	local cfg_path=""
	echo -ne "\e[1m"
	echo "Usage: $(basename "$0") <Config Name>"
	echo -ne "\e[0m"
	echo "Available Configs to Edit:"
	for key in "${!CFGEDIT_CFG_FILES[@]}"; do
		cfg_path="$(get_existing_cfg_path "${key}")"
		if test $? -ne 0; then
			missed_app_names+=("${key}")
			continue
		fi
		printf "  %-10s %s\n" "${key}:" "${cfg_path}"
	done
	echo -ne "\e[0m"
	if test "${#missed_app_names[@]}" -eq 0; then
		return
	fi
	echo "Possible Configs to Create:"
	for key in "${missed_app_names[@]}"; do
		cfg_path="$(get_first_cfg_path "${key}")"
		if test $? -ne 0; then
			pr_error "I don't feel so good mr stark.."
			continue
		fi
		printf "  %-10s %s\n" "${key}:" "${cfg_path}"
	done
	echo -ne "\e[0m"
}

for key in "${!CFGEDIT_CFG_FILES[@]}"; do
	if [[ "$1" != "$key" ]]; then
		continue
	fi
	cfg_path="$(get_existing_cfg_path "${key}")"
	if test $? -ne 0; then
		cfg_path="$(get_first_cfg_path "${key}")"
	fi
	"$EDITOR" "${cfg_path}"
	exit $?
done

pr_usage
